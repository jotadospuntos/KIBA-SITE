# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these for Production (and Preview where noted in CLAUDE.md).

# --- Database (Supabase, Project Settings -> Database -> Connection string) ---
# Runtime: the TRANSACTION pooler, port 6543.
DATABASE_URL=
# Migrations only (npm run db:migrate, from your machine): the SESSION pooler, port 5432.
DIRECT_URL=

# --- Admin login (Auth.js + Google) ---
# Generate with: openssl rand -base64 33
AUTH_SECRET=
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Blog images: the PUBLIC Blob store "kiba-blog-images" (connected with the prefix "blog") ---
# On Vercel only blog_STORE_ID is needed (it pairs with Vercel's automatic OIDC identity).
# Locally, paste the token from the store's ".env.local" snippet here - it's listed there as
# BLOB_READ_WRITE_TOKEN, but must be renamed, or it would be mistaken for the debt schedule's store.
blog_STORE_ID=
BLOG_READ_WRITE_TOKEN=
